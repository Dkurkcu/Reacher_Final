<mujoco model="reacher">
    <compiler angle="radian"/>
    <option gravity="0 0 -9.81" timestep="0.01"/>

    <default>
        <joint damping="0.1"/>
        <geom friction="1.0 0.1 0.1" density="300" rgba="0.8 0.6 0.4 1"/>
    </default>

    <worldbody>
        <geom type="plane" pos="0 0 0" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>

        <body name="base" pos="0 0 0.1">
            <body name="link0" pos="0 0 0">
                <geom name="link0_geom" type="capsule" fromto="0 0 0 0.5 0 0" size="0.05"/>
                <joint name="joint0" type="hinge" axis="0 0 1" limited="false" damping="0.1"/>
                <body name="link1" pos="0.5 0 0">
                    <geom name="link1_geom" type="capsule" fromto="0 0 0 0.5 0 0" size="0.05"/>
                    <joint name="joint1" type="hinge" axis="0 0 1" limited="false" damping="0.1"/>
                    <body name="fingertip" pos="0.5 0 0">
                        <geom name="fingertip_geom" type="sphere" size="0.05" rgba="0.2 0.8 0.2 1"/>
                        <site name="fingertip_site" pos="0 0 0" size="0.01" rgba="0 0 1 1"/>
                    </body>
                </body>
            </body>
        </body>

        <body name="box_body" pos="0 0 0.05">
            <joint name="box_joint_free" type="free"/>
            <geom name="box_geom" type="box" size="0.05 0.05 0.05" rgba="1 0.5 0 1" mass="0.5"/>
            <site name="box_site" pos="0 0 0" size="0.01" rgba="1 0.5 0 1"/>
        </body>

        <site name="target" pos="1.0 0.0 0.1" size="0.05" rgba="1 0 0 1"/>
    </worldbody>

    <actuator>
        <motor joint="joint0" gear="3" ctrllimited="true" ctrlrange="-3 3"/>
        <motor joint="joint1" gear="3" ctrllimited="true" ctrlrange="-3 3"/>
    </actuator>
</mujoco>